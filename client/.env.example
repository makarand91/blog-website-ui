# Frontend Development Server Port
VITE_PORT=3000

# API Base URL (leave empty to use proxy, or set to direct backend URL)
# Development (using proxy): leave empty or comment out
# Production: set to your backend URL (e.g., https://api.example.com/api)
# VITE_API_BASE_URL=

# Proxy Target (only used in development when using proxy)
# This is the backend server URL that will be proxied
VITE_PROXY_TARGET=http://localhost:5000
